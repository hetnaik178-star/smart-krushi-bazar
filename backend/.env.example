# Server Configuration
PORT=5000

# MongoDB Database Connection String (Use MongoDB Atlas for production deployment)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_krushi_bazar?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_krushi_bazar

# JWT Authentication Secret Key (Use a strong, random string in production)
JWT_SECRET=super_secret_production_key_change_me_123

# Frontend URL for Socket.io and CORS (e.g., https://smart-krushi-bazar.vercel.app or *)
FRONTEND_URL=*

# Razorpay Payment Gateway (Optional: leave blank to automatically use test mock simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Cloud Storage for Uploads (Optional: leave as is to use local /uploads folder)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Third-Party APIs (Has built-in fallbacks if not provided)
# MANDI_API_KEY=
# AI_DISEASE_API_URL=
# AI_DISEASE_API_TOKEN=
